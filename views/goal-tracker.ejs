<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Goal Tracker | DevBase</title>
    <link rel="stylesheet" href="css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  </head>


  <body>

    <header>
      <div class="header">
        <div class="wrapper">

          <div class="logo">
            <a href="/dashboard">
              <img src="images/devbase-logo.png" alt="DevBase Logo">
            </a>
          </div>

          <nav>
            <ul>
              <li><a href="/dashboard" target="_blank">Home</a></li>
              <li><a href="/goals" target="_blank">Goals</a></li>
              <li><a href="/opportunities" target="_blank">Opportunities</a></li>
              <li><a href="/projects" target="_blank">Projects</a></li>
              <li><a href="/resumes" target="_blank">Resumes</a></li>
              <li><a href="/ideas" target="_blank">Ideas</a></li>
              <li><a href="/journal" target="_blank">Journal</a></li>
              <li><a href="/hub" target="_blank">Hub</a></li>
              <li><a href="/logout">Logout</a></li>
            </ul>
          </nav>

          <div class="c"></div>
        </div>
      </div>
    </header>


    <section class="goal-tracker">
      <div class="wrapper">

        <div class="page-heading">
          <h1>Goal Tracker</h1>
          <p>
            Set meaningful goals, monitor your progress, and stay consistent.
          </p>
        </div>

        <div class="goal-overview">
          <div class="overview-card">
            <h2><%= totalGoals %></h2>
            <p>Total Goals</p>
          </div>
          <div class="overview-card">
            <h2><%= completedGoals %></h2>
            <p>Completed</p>
          </div>
          <div class="overview-card">
            <h2><%= inProgressGoals %></h2>
            <p>In Progress</p>
          </div>
          <div class="overview-card">
            <h2><%= completionRate %></h2>
            <p>Completion Rate</p>
          </div>
        </div>

        <div class="goal-actions">
          <form action="/goals" method="POST" class="goal-form">
            <input type="text" name="title" placeholder="Goal Title" required >
            <input type="text" name="description" placeholder="Description" >
            <select name="category">
              <option value="DSA">DSA</option>
              <option value="Development">Development</option>
              <option value="Placement">Placement</option>
              <option value="Hackathon">Hackathon</option>
              <option value="Personal">Personal</option>
            </select>
            <input type="date" name="deadline">
            <select name="priority">
              <option value="Low">Low</option>
              <option value="Medium">Medium</option>
              <option value="High">High</option>
            </select>
            <select name="status">
              <option value="Pending">Pending</option>
              <option value="In Progress">In Progress</option>
              <option value="Completed">Completed</option>
            </select>
            <button type="submit" class="add-goal-btn">
              <i class="fa-solid fa-plus"></i>
              Add Goal
            </button>
          </form>
        </div>

        <div class="goal-list">

          <% if(goals.length===0){ %>
            <h3>No Goals Yet</h3>
          <% } %>

          <% goals.forEach(goal=>{ %>
          <div class="goal-card">

            <div class="goal-top">
              <h3><%= goal.title %></h3>
              <form action="/goals/update-priority/<%= goal._id %>" method="POST">
                <select name="priority" class="priority-select" onchange="this.form.submit()">
                  <option value="Low"
                    <%= goal.priority==="Low" ? "selected" : "" %>>
                    Low
                  </option>

                  <option value="Medium"
                    <%= goal.priority==="Medium" ? "selected" : "" %>>
                    Medium 
                  </option>

                  <option value="High"
                    <%= goal.priority==="High" ? "selected" : "" %>>
                    High
                  </option>
                </select>
              </form>
            </div>

            <p>
              <%= goal.description %>
            </p>
            <div class="goal-info">
              <span>
                <i class="fa-regular fa-calendar"></i>
                <%= goal.deadline ? goal.deadline.toDateString() : "No Deadline" %>
              </span>

              <form action="/goals/update-status/<%= goal._id %>" method="POST">
                <select name="status" onchange="this.form.submit()">
                  <option value="Pending"
                    <%= goal.status==="Pending" ?"selected" : "" %>>
                    Pending
                  </option>

                  <option value="In Progress"
                    <%= goal.status==="In Progress" ? "selected" : "" %>>
                    In Progress
                  </option>

                  <option value="Completed"
                    <%= goal.status==="Completed" ? "selected" : "" %>>
                    Completed
                  </option>
                </select>
              </form>
    
            </div>
            <div class="goal-footer">
              <div class="goal-buttons">
                <a href="/goals/delete/<%= goal._id %>" class="delete-btn">
                  Delete
                </a>
              </div>
            </div>
          </div>
          <% }) %>
        </div>

      </div>
    </section>


    <footer>
      <div class="footer">
        <div class="wrapper">

          <div class="fbox">
            <h2>DevBase</h2>
            <p>
              DevBase is your complete developer workspace designed to help
              you organize projects, manage opportunities, track goals,
              store resumes, capture ideas, and document your growth—all in one place.
            </p>
          </div>

          <div class="fbox">
            <h3>Workspace</h3>
            <div class="fbox2">
              <ul>
                <li><a href="#"><i class="fa-solid fa-house"></i> Dashboard</a></li>
                <li><a href="#"><i class="fa-solid fa-bullseye"></i> Goals</a></li>
                <li><a href="#"><i class="fa-solid fa-briefcase"></i> Opportunities</a></li>
                <li><a href="#"><i class="fa-solid fa-folder-open"></i> Projects</a></li>
                <li><a href="#"><i class="fa-solid fa-file-lines"></i> Resumes</a></li>
              </ul>
            </div>
          </div>

          <div class="fbox">
            <h3>Resources</h3>
            <div class="fbox2">
              <ul>
                <li><a href="#"><i class="fa-solid fa-lightbulb"></i> Ideas</a></li>
                <li><a href="#"><i class="fa-solid fa-book-open"></i> Journal</a></li>
                <li><a href="#"><i class="fa-solid fa-link"></i> Developer Hub</a></li>
                <li><a href="#"><i class="fa-solid fa-circle-question"></i> Help Center</a></li>
                <li><a href="#"><i class="fa-solid fa-envelope"></i> Contact</a></li>
              </ul>
            </div>
          </div>

          <div class="fbox">
            <h3>Connect</h3>
            <div class="fbox3">
              <a href="#"><i class="fa-brands fa-github"></i></a>
              <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
              <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="#"><i class="fa-solid fa-globe"></i></a>
            </div>
            <p class="footer-tagline">
              Build. Track. Grow.
            </p>
          </div>

          <div class="c"></div>
        </div>
      </div>

      <div class="copy">
        <div class="wrapper">
    
          <div class="copyright">
            <p>
              © 2026 DevBase. Designed & Developed by Smaranika.
            </p>
          </div>

          <div class="policy">
            <a href="#">Privacy Policy</a>
            <p>&#124;</p>
            <a href="#">Terms & Conditions</a>
          </div>

          <div class="c"></div>
        </div>
      </div>
    </footer>

  </body>

</html>