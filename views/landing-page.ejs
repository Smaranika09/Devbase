<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DevBase | Your Complete Developer Workspace</title>
    <link rel="stylesheet" href="css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  </head>

  
  <body>

    <section class="welcome-section">
      <div class="wrapper">
        <div class="welcome-content">

          <div class="welcome-left">
            <h1>DevBase</h1>
            <h2>Your Complete Developer Workspace</h2>
            <p>
              Organize your projects, track opportunities, manage resumes,
              document your journey, and achieve your developer goals —
              all in one place.
            </p>
            <a href="/signup" class="get-started-btn" target="_blank">
              Let's Get Started
            </a>
          </div>

          <div class="welcome-right">
            <img src="images/landing-page-img.png" alt="devbase landing page img">
          </div>

        </div>
      </div>
    </section>


    <section class="features-section">
      <div class="wrapper">

        <div class="section-heading">
          <h2>Everything You Need</h2>
          <p>
            A productivity workspace built specifically for developers.
          </p>
        </div>

        <div class="feature-grid">
          <div class="feature-card">
            <i class="fa-solid fa-bullseye"></i>
            <h3>Goal Tracker</h3>
            <p>Plan your goals, monitor progress, and stay consistent.</p>
          </div>
          <div class="feature-card">
            <i class="fa-solid fa-briefcase"></i>
            <h3>Opportunity Tracker</h3>
            <p>Manage internships, jobs, hackathons, and deadlines.</p>
          </div>
          <div class="feature-card">
            <i class="fa-solid fa-folder-open"></i>
            <h3>Project Vault</h3>
            <p>Upload projects and organize your development portfolio.</p>
          </div>
          <div class="feature-card">
            <i class="fa-solid fa-file-lines"></i>
            <h3>Resume Vault</h3>
            <p>Store multiple resume versions for different roles.</p>
          </div>
          <div class="feature-card">
            <i class="fa-solid fa-lightbulb"></i>
            <h3>Idea Vault</h3>
            <p>Capture project, startup, and hackathon ideas instantly.</p>
          </div>
          <div class="feature-card">
            <i class="fa-solid fa-book-open"></i>
            <h3>Developer Journal</h3>
            <p>Record what you learn and reflect on your progress.</p>
          </div>
          <div class="feature-card">
            <i class="fa-solid fa-link"></i>
            <h3>Developer Hub</h3>
            <p>Access all your favorite developer platforms quickly.</p>
          </div>
          <div class="feature-card">
            <i class="fa-solid fa-chart-line"></i>
            <h3>Personal Dashboard</h3>
            <p>View everything important from one clean workspace.</p>
          </div>
        </div>

      </div>
    </section>


    <footer>
      <div class="wrapper">
        <p>
          © 2026 DevBase. Designed & Developed by Smaranika.
        </p>
      </div>
    </footer>
    

  </body>
</html>