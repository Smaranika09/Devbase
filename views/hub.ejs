<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Developer Hub | DevBase</title>
    <link rel="stylesheet" href="css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
  </head>


  <body>

    <header>
      <div class="header">
        <div class="wrapper">

          <div class="logo">
            <a href="/dashboard">
              <img src="images/devbase-logo.png" alt="DevBase Logo">
            </a>
          </div>

          <nav>
            <ul>
              <li><a href="/dashboard" target="_blank">Home</a></li>
              <li><a href="/goals" target="_blank">Goals</a></li>
              <li><a href="/opportunities" target="_blank">Opportunities</a></li>
              <li><a href="/projects" target="_blank">Projects</a></li>
              <li><a href="/resumes" target="_blank">Resumes</a></li>
              <li><a href="/ideas" target="_blank">Ideas</a></li>
              <li><a href="/journal" target="_blank">Journal</a></li>
              <li><a href="/hub" target="_blank">Hub</a></li>
              <li><a href="/logout">Logout</a></li>
            </ul>
          </nav>

          <div class="c"></div>
        </div>
      </div>
    </header>

    <section class="developer-hub">
      <div class="wrapper">

        <div class="page-heading">
          <h1>Developer Hub</h1>
          <p>
            Keep all your favorite platforms, tools and resources organized in one place.
          </p>
        </div>

        <div class="hub-overview">
          <div class="overview-card">
            <h2><%= totalLinks %></h2>
            <p>Total Links</p>
          </div>
          <div class="overview-card">
            <h2><%= favoriteLinks %></h2>
            <p>Favorites</p>
          </div>
          <div class="overview-card">
            <h2><%= recentLinks %></h2>
            <p>Recently Added</p>
          </div>
          <div class="overview-card">
            <h2><%= categories %></h2>
            <p>Categories</p>
          </div>
        </div>

        <div class="hub-search-section">
          <form action="/hub" method="GET">
            <input type="text" name="search" placeholder="Search links..." value="<%= search || '' %>">
            <button type="submit">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </form>
        </div>

        <div class="add-link-section">
          <h2>Add New Link</h2>

          <form action="/hub" method="POST" class="hub-form">
            <input type="text" name="title" placeholder="Platform Name" required>
            <input type="url" name="url" placeholder="https://..." required>
            <input type="text" name="username" placeholder="Username (Optional)">
            <select name="category" required>
              <option value="">Select Category</option>
              <option value="Coding">
                Coding
              </option>
              <option value="Professional">
                Professional
              </option>
              <option value="Learning">
                Learning
              </option>
              <option value="AI">
                AI
              </option>
              <option value="Social">
                Social
              </option>
              <option value="Other">
                Other
              </option>
            </select>
            <textarea name="description" placeholder="Description (optional)">
            </textarea>
            <button type="submit" class="add-link-btn" >
              <i class="fa-solid fa-plus"></i>
              Add Link
            </button>
          </form>
        </div>

        <div class="hub-list">

          <% if(links.length===0){ %>
          <div class="empty-hub">
            <i class="fa-solid fa-link"></i>
            <h2>No Links Yet</h2>
            <p>Add your first developer resource above.</p>
          </div>
          <% } %>

          <% links.forEach(link=>{ %>
          <div class="hub-card">
            <div class="hub-header">
              <div>
                <h3><%= link.title %></h3>
                <p>
                  <%= link.username || "No Username" %>
                </p>
              </div>
              <a href="/hub/favorite/<%= link._id %>" class="favorite-btn" >
                <% if(link.favorite){ %>
                  <i class="fa-solid fa-star"></i>
                <% } else{ %>
                  <i class="fa-regular fa-star"></i>
                <% } %>
              </a>
            </div>
            <div class="hub-info">
              <p>
                <strong>Category :</strong>
                <%= link.category %>
              </p>
              <p class="hub-url">
                <strong>URL :</strong>
                <a href="<%= link.url %>" target="_blank">
                  <%= link.url %>
                </a>
              </p>
            </div>
            <div class="hub-buttons">
              <a href="<%= link.url %>" target="_blank" class="visit-btn">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
                Visit
              </a>
              <a href="/hub/delete/<%= link._id %>" class="delete-btn" >
                <i class="fa-solid fa-trash"></i>
                Delete
              </a>
            </div>
          </div>
          <% }) %>

        </div>

      </div>
    </section>


    <footer>
      <div class="footer">
        <div class="wrapper">

          <div class="fbox">
            <h2>DevBase</h2>
            <p>
              DevBase is your complete developer workspace designed to help
              you organize projects, manage opportunities, track goals,
              store resumes, capture ideas, and document your growth—all in one place.
            </p>
          </div>

          <div class="fbox">
            <h3>Workspace</h3>
            <div class="fbox2">
              <ul>
                <li><a href="#"><i class="fa-solid fa-house"></i> Dashboard</a></li>
                <li><a href="#"><i class="fa-solid fa-bullseye"></i> Goals</a></li>
                <li><a href="#"><i class="fa-solid fa-briefcase"></i> Opportunities</a></li>
                <li><a href="#"><i class="fa-solid fa-folder-open"></i> Projects</a></li>
                <li><a href="#"><i class="fa-solid fa-file-lines"></i> Resumes</a></li>
              </ul>
            </div>
          </div>

          <div class="fbox">
            <h3>Resources</h3>
            <div class="fbox2">
              <ul>
                <li><a href="#"><i class="fa-solid fa-lightbulb"></i> Ideas</a></li>
                <li><a href="#"><i class="fa-solid fa-book-open"></i> Journal</a></li>
                <li><a href="#"><i class="fa-solid fa-link"></i> Developer Hub</a></li>
                <li><a href="#"><i class="fa-solid fa-circle-question"></i> Help Center</a></li>
                <li><a href="#"><i class="fa-solid fa-envelope"></i> Contact</a></li>
              </ul>
            </div>
          </div>

          <div class="fbox">
            <h3>Connect</h3>
            <div class="fbox3">
              <a href="#"><i class="fa-brands fa-github"></i></a>
              <a href="#"><i class="fa-brands fa-linkedin-in"></i></a>
              <a href="#"><i class="fa-brands fa-x-twitter"></i></a>
              <a href="#"><i class="fa-solid fa-globe"></i></a>
            </div>
            <p class="footer-tagline">
              Build. Track. Grow.
            </p>
          </div>

          <div class="c"></div>
        </div>
      </div>

      <div class="copy">
        <div class="wrapper">
    
          <div class="copyright">
            <p>
              © 2026 DevBase. Designed & Developed by Smaranika.
            </p>
          </div>

          <div class="policy">
            <a href="#">Privacy Policy</a>
            <p>&#124;</p>
            <a href="#">Terms & Conditions</a>
          </div>

          <div class="c"></div>
        </div>
      </div>
    </footer>

  </body>
</html>